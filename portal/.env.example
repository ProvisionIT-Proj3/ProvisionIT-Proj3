# Build-time settings. Everything with a VITE_ prefix is baked into the public
# JavaScript, so only put values here that are safe for anyone to see.
# Never put the Supabase service role key or a database URL in this file.

# Leave empty in dev: the vite proxy sends /api to localhost:3000.
# On Vercel set it to the API address, e.g. https://your-api.up.railway.app/api/v1
VITE_API_URL=

# Login. Leave both empty to run with no login (local API with AUTH_REQUIRED=false).
# Supabase > Project Settings > API: the project URL and the anon (public) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true = run on sample data, no backend and no login needed
VITE_USE_MOCK=false
