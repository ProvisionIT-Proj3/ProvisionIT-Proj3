# leave empty in dev, the vite proxy sends /api to localhost:3000 (set it if the API is not mounted at /api/v1)
VITE_API_URL=
# true = run on sample data, no backend needed
VITE_USE_MOCK=false
# from Supabase: Project Settings > API. Project URL and the anon / public key only, never the service_role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
