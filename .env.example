# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string (Supabase > Project Settings > Database)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Base64-encoded 32-byte key used to encrypt OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# Xero OAuth app
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/auth/xero/callback

# QuickBooks OAuth app
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/auth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# API access control. OFF by default; turn on once the portal sends a Supabase
# access token as "Authorization: Bearer <token>".
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Role (in user_profiles) allowed to sync and delete connections
ADMIN_ROLE=admin

PORT=3000
